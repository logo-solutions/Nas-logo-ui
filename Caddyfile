# Simple default configuration - routes all requests appropriately
:80 {
    @api path /api /api/*
    @auth path /auth /auth/*

    handle @auth {
        reverse_proxy localhost:8000
    }

    handle @api {
        uri strip_prefix /api
        reverse_proxy localhost:8000
    }

    handle {
        reverse_proxy localhost:5173
    }
}

:443 {
    tls internal

    @api path /api /api/*
    @auth path /auth /auth/*

    handle @auth {
        reverse_proxy localhost:8000
    }

    handle @api {
        uri strip_prefix /api
        reverse_proxy localhost:8000
    }

    handle {
        reverse_proxy localhost:5173
    }
}
