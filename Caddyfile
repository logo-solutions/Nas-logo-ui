alo.logo-solutions.fr {
    tls /etc/caddy/certs/nas-chain.crt /etc/caddy/certs/nas-leaf.key

    # Matcher pour les requêtes /api
    @api path /api /api/*

    # Route /api vers backend FastAPI sur port 8000
    handle @api {
        reverse_proxy host.docker.internal:8000 {
            header_up Host {host}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }

    # Route tout le reste vers frontend React sur port 8001
    handle {
        reverse_proxy host.docker.internal:8001 {
            header_up Host {host}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }
}
