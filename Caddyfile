nas.logo-solutions.fr {
    tls /etc/caddy/certs/nas-chain.crt /etc/caddy/certs/nas-leaf.key

    # Matcher pour les requêtes /api
    @api path /api /api/*

    # Route /api vers gateway avec strip prefix
    handle @api {
        uri strip_prefix /api
        reverse_proxy nas-logo-gateway:8000
    }

    # Route tout le reste vers UI
    handle {
        reverse_proxy nas-logo-ui:8080 {
            header_up Host {host}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }
}

immich.nas-logo-solutions.fr {
    tls internal
    reverse_proxy 100.113.214.55:2283 {
        header_up Host 100.113.214.55:2283
    }
}

