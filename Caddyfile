{
  auto_https off
}

(site) {
    handle /auth* {
        reverse_proxy nas-logo-gateway:8000
    }

    handle /api* {
        uri strip_prefix /api
        reverse_proxy nas-logo-gateway:8000
    }

    handle /immich* {
        reverse_proxy nas-logo-gateway:8000
    }

    handle * {
        reverse_proxy nas-logo-ui:8080
    }
}

nas.logo-solutions.fr {
    tls /etc/caddy/certs/nas-chain.crt /etc/caddy/certs/nas-leaf.key
    import site
}

192.168.1.34 {
    tls /etc/caddy/certs/nas-chain.crt /etc/caddy/certs/nas-leaf.key
    import site
}

alo.logo-solutions.fr {
    tls /etc/caddy/certs/nas-chain.crt /etc/caddy/certs/nas-leaf.key

    handle /api* {
        reverse_proxy alo-backend:8000
    }

    handle * {
        reverse_proxy alo-frontend
    }
}

alo.logo-solutions.fr:80 {
    handle /api* {
        reverse_proxy alo-backend:8000
    }

    handle * {
        reverse_proxy alo-frontend
    }
}

:443 {
    tls /etc/caddy/certs/nas-chain.crt /etc/caddy/certs/nas-leaf.key
    import site
}

:80 {
    import site
}
