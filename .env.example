# NAS-Logo-UI Environment Configuration
# Copy this file to .env and fill in actual values for your environment

# ============ Docker / Deployment ============
NODE_ENV=production

# ============ Gateway (API) Configuration ============
# JWT secret for token signing - MUST be changed in production!
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# Immich service configuration
IMMICH_API_KEY=dg46m83TgQBP4r8pxPloTnagaNUl2wWcgmNlB7Wk
IMMICH_URL=http://100.113.214.55:2283

# Other service URLs (default to NAS infrastructure via Tailscale)
PAPERLESS_URL=http://100.113.214.55:8010
MEILISEARCH_URL=http://100.113.214.55:7700
N8N_URL=http://100.113.214.55:5679
GRAFANA_URL=http://100.113.214.55:3000
NTFY_URL=http://100.113.214.55:80

# ============ Caddy Configuration ============
# Certificate paths for HTTPS (should be volume-mounted in production)
CADDY_CERT_CRT=/etc/caddy/certs/nas-chain.crt
CADDY_CERT_KEY=/etc/caddy/certs/nas-leaf.key

# Primary domain
PRIMARY_DOMAIN=nas.logo-solutions.fr

# ============ Frontend Configuration ============
VITE_API_BASE_URL=/api
VITE_GATEWAY_URL=http://localhost:8000

# ============ Colima Configuration ============
COLIMA_MEMORY=8
COLIMA_CPU=4
COLIMA_DISK=100
